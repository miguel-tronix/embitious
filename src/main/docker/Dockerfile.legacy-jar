# Dockerfile.legacy-jar — JVM image using a single fat/uber-jar.
# Use when the Quarkus fast-jar layout is not available (legacy mode). Requires: ./mvnw package -Dquarkus.package.jar.type=uber-jar
FROM registry.access.redhat.com/ubi9/openjdk-21-runtime:1.21

ENV LANGUAGE='en_US:en'

COPY target/*.jar /deployments/

EXPOSE 8080
USER 185

ENV JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
ENV JAVA_APP_JAR="/deployments/embitious-1.0.0-SNAPSHOT.jar"

ENTRYPOINT [ "/opt/jboss/container/java/run/run-java.sh" ]
