# Dockerfile.native — GraalVM native image running on a minimal UBI base.
# Produces the smallest image with fastest startup. Requires: ./mvnw package -Dnative
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.5

WORKDIR /work/
COPY target/*-runner /work/application

RUN chmod 775 /work

EXPOSE 8080
USER 1001

CMD ["./application", "-Dquarkus.http.host=0.0.0.0"]
