# Dockerfile.native-micro — Smallest possible native image using Quarkus micro base image.
# Use for distroless-style deployments. Requires: ./mvnw package -Dnative
FROM quay.io/quarkus/quarkus-micro-image:2.0

WORKDIR /work/
COPY target/*-runner /work/application

RUN chmod 775 /work

EXPOSE 8080
USER 1001

CMD ["./application", "-Dquarkus.http.host=0.0.0.0"]
